[Unit]
Description=Asura Resume Center — bridge watcher (keeps the store synced)
After=default.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
Environment=PYTHONPATH=@APP_DIR@/arc
Environment=ARC_WATCH_INTERVAL=15
ExecStart=@APP_DIR@/.venv/bin/python -c "import watcher; watcher.run_forever()"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
