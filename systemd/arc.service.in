[Unit]
Description=Asura Resume Center — server (loopback dashboard)
After=default.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
Environment=PYTHONPATH=@APP_DIR@/arc
ExecStart=@APP_DIR@/.venv/bin/python -c "import server; server.main()"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
